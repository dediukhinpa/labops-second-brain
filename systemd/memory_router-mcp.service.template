[Unit]
Description=second_brain Memory Router MCP (read-side)
After=postgresql.service network.target
Wants=postgresql.service

[Service]
Type=simple
User={{SERVICE_USER}}
Group={{SERVICE_USER}}
WorkingDirectory={{INSTALL_DIR}}
Environment=PYTHONPATH={{INSTALL_DIR}}
Environment=MCP_PORT=5002
# Bind to loopback only — agents are local; expose beyond via a reverse proxy,
# never by opening the raw MCP port to the world.
Environment=MCP_HOST=127.0.0.1
Environment=FASTEMBED_CACHE_DIR={{STATE_DIR}}/fastembed
# huggingface_hub's xet transfer backend writes its own log/dedup cache to
# ~/.cache/huggingface/xet regardless of FASTEMBED_CACHE_DIR, which sits
# outside ReadWritePaths under ProtectHome=yes — a fresh (uncached) model
# download crash-loops on "Read-only file system". Xet is a performance-only
# transfer optimization; disabling it falls back to plain HTTP, which does
# respect FASTEMBED_CACHE_DIR.
Environment=HF_HUB_DISABLE_XET=1
EnvironmentFile={{ETC_DIR}}/secrets.env
ExecStart={{INSTALL_DIR}}/.venv/bin/python -m services.memory_router_mcp.server
Restart=on-failure
RestartSec=5

NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ReadWritePaths={{INSTALL_DIR}}/vault {{LOG_DIR}} {{STATE_DIR}}
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LockPersonality=yes
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
# FastEmbed paraphrase-multilingual-mpnet-base-v2 is ~1GB resident + uvicorn overhead.
MemoryMax=2G

[Install]
WantedBy=multi-user.target
