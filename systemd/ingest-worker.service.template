[Unit]
Description=second_brain Ingest Worker
After=postgresql.service network.target
Wants=postgresql.service

[Service]
Type=simple
User={{SERVICE_USER}}
Group={{SERVICE_USER}}
WorkingDirectory={{INSTALL_DIR}}
Environment=PYTHONPATH={{INSTALL_DIR}}
Environment=FASTEMBED_CACHE_DIR={{STATE_DIR}}/fastembed
# See memory_router-mcp.service.template for why: xet ignores FASTEMBED_CACHE_DIR
# and crash-loops under ProtectHome=yes on a fresh model download.
Environment=HF_HUB_DISABLE_XET=1
EnvironmentFile={{ETC_DIR}}/secrets.env
ExecStart={{INSTALL_DIR}}/.venv/bin/python -m services.ingest_worker.worker
Restart=on-failure
RestartSec=5

NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ReadWritePaths={{INSTALL_DIR}}/vault {{LOG_DIR}} {{STATE_DIR}}
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LockPersonality=yes
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
# FastEmbed paraphrase-multilingual-mpnet-base-v2 is ~1GB resident.
MemoryMax=2G

[Install]
WantedBy=multi-user.target
